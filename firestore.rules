rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.id == userId;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id']);

      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.description is string
                    && request.resource.data.imageUrl is string
                    && request.resource.data.timestamp is timestamp;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                    && (
                      (
                        request.resource.data.likes.size() == resource.data.get('likes', []).size() + 1
                        && request.resource.data.likes.hasAll(resource.data.get('likes', []))
                        && request.resource.data.likes.hasAny([request.auth.uid])
                        && !resource.data.get('likes', []).hasAny([request.auth.uid])
                      )
                      ||
                      (
                        request.resource.data.likes.size() == resource.data.get('likes', []).size() - 1
                        && resource.data.get('likes', []).hasAll(request.resource.data.likes)
                        && resource.data.get('likes', []).hasAny([request.auth.uid])
                        && !request.resource.data.likes.hasAny([request.auth.uid])
                      )
                    );

      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
